# Arbitrator — environment template (development).
#
# Copy to `.env` at the repo root (gitignored). docker compose reads that file.
#
# Bun loads only the `.env` in each app's OWN directory (it does not walk up),
# so the per-app blocks at the bottom also need to exist as
# `apps/<name>/.env`. See AGENTS.md → Environment.
#
# Never commit real values. `.env` is gitignored; this template is not.

# ─────────────────────────────────────────────────────────────── hosts / URLs

# Postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=arbitrator
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arbitrator

# RabbitMQ
AMQP_URL=amqp://arbitrator:arbitrator@localhost:5672
AMQP_EXCHANGE=arbitrator
# AMQP_URL falls back to RABBITMQ_URL if you use the other name
# RABBITMQ_URL=amqp://arbitrator:arbitrator@localhost:5672

# Redis
REDIS_URL=redis://localhost:6379

# Services
LISTER_URL=http://localhost:3001
SENDER_URL=http://localhost:3002

# nginx TLS reverse proxy (infra/nginx/README.md)
LOCAL_DOMAIN=localhost
UI_UPSTREAM=host.docker.internal:3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ─────────────────────────────────────────────────────────────── external APIs

# CoinMarketCap (cmc-collector, old-lister-migrator)
CMC_API_KEY=

# Exchange keys — required only to crawl these venues; blank = skipped.
# binance / gate / kucoin / bitget are keyless.
MEXC_API_KEY=
MEXC_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ─────────────────────────────────────────────────────────────── per-app

NODE_ENV=development

# apps/lister/.env
#   DATABASE_URL, AMQP_URL, AMQP_EXCHANGE, REDIS_URL
# apps/sender/.env
#   LISTER_URL, AMQP_URL, AMQP_EXCHANGE, REDIS_URL
# apps/receiver/.env
#   DATABASE_URL, AMQP_URL, AMQP_EXCHANGE, REDIS_URL, RECEIVER_WORKER=src/index.ts
RECEIVER_WORKER=src/index.ts
# apps/ui/.env
#   PORT, LISTER_URL, SENDER_URL
PORT=3000
# apps/cmc-collector/.env
#   DATABASE_URL, LISTER_URL, CMC_API_KEY
# apps/chain-metadata-collector/.env
#   LISTER_URL, MEXC_*, OKX_*, BYBIT_*
# apps/old-lister-migrator/.env
#   DATABASE_URL, LISTER_URL, CMC_API_KEY
