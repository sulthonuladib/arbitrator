PATH_add ./node_modules/.bin

export DATABASE_HOST="localhost"
export DATABASE_PORT="5432"
export DATABASE_USER="postgres"
export DATABASE_PASSWORD="postgres"
export DATABASE_NAME="arbitrator"

export DATABASE_URL="postgres://postgres:postgres@localhost:5432/arbitrator"

export AMQP_URL="amqp://arbitrator:arbitrator@localhost:5672"
export AMQP_EXCHANGE="arbitrator"

export REDIS_URL="redis://localhost:6379"

LISTER_URL="http://localhost:3001"

# nginx TLS reverse proxy (see infra/nginx/README.md)
# One hostname only: the machine's own mDNS name, no subdomains.
export LOCAL_DOMAIN="$(hostname).local"
export UI_UPSTREAM="host.docker.internal:3000"
export NGINX_HTTP_PORT="80"
export NGINX_HTTPS_PORT="443"
