# Upgrade/keepalive handling. Empty value keeps upstream keepalive alive for
# normal requests while forwarding "upgrade" for websockets.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

upstream ui_upstream {
    server ${UI_UPSTREAM};
    keepalive 16;
}

upstream rabbitmq_upstream {
    server ${RABBITMQ_MANAGEMENT_UPSTREAM};
    keepalive 16;
}

# --- HTTP: ACME challenge + redirect everything to HTTPS ---
server {
    listen      80 default_server;
    listen      [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Single TLS entrypoint: ${LOCAL_DOMAIN} (and localhost) ---
#
# Everything is served from one hostname; add services as path prefixes below
# (e.g. `location /api/ { proxy_pass http://lister_upstream; }`) instead of
# inventing subdomains.
server {
    listen      443 ssl default_server;
    listen      [::]:443 ssl default_server;
    http2       on;
    server_name ${LOCAL_DOMAIN} localhost;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # Uncomment once you are happy with the cert and always want HTTPS.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    # Elysia/htmx streams HTML; also covers SSE and websocket upgrades.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering    off;
    proxy_cache        off;

    location / {
        proxy_pass http://ui_upstream;
    }

    # RabbitMQ management UI + HTTP API, mounted as a path prefix.
    # The plugin itself is configured with `management.path_prefix = /rabbitmq`
    # (infra/rabbitmq/conf.d/20-path-prefix.conf), so the URI is forwarded
    # UNCHANGED — nginx must not strip the prefix, or the UI's assets, its
    # session cookie path and its /rabbitmq/api calls all break.
    location = /rabbitmq {
        return 301 /rabbitmq/;
    }

    location /rabbitmq/ {
        # No trailing slash on purpose: RabbitMQ is configured with
        # `management.path_prefix = /rabbitmq`, so it expects the prefix to
        # arrive. Stripping it here would 404 every asset and /rabbitmq/api call.
        proxy_pass http://rabbitmq_upstream;

        # Buffered responses: the management UI is plain assets + JSON polling
        # (no SSE/streaming), and buffering is what lets sub_filter below see
        # whole responses instead of fragments (the server block turns it off
        # globally for the Elysia/htmx UI).
        proxy_buffering on;

        # RabbitMQ 4.4's js/main.js hardcodes two root-relative URLs that ignore
        # `management.path_prefix`: the logout redirect (location.href = "/")
        # and the import-definitions form action ("/definitions"). Rewrite them
        # so logging out returns to the UI instead of the arbitrator app. If a
        # future release renames those strings the filter simply stops
        # matching — it cannot break the UI.
        sub_filter_once off;
        sub_filter_types application/javascript;
        sub_filter 'location.href =  "/"' 'location.href =  "/rabbitmq/"';
        sub_filter 'var form_action = "/definitions"' 'var form_action = "/rabbitmq/definitions"';
    }
}
