# Upgrade/keepalive handling. Empty value keeps upstream keepalive alive for
# normal requests while forwarding "upgrade" for websockets.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}

upstream ui_upstream {
    server ${UI_UPSTREAM};
    keepalive 16;
}

upstream rabbitmq_upstream {
    server ${RABBITMQ_UPSTREAM};
    keepalive 16;
}

# --- HTTP: ACME challenge + redirect everything to HTTPS ---
server {
    listen      80 default_server;
    listen      [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- UI (default vhost: bare IP / unknown SNI land here) ---
server {
    listen      443 ssl default_server;
    listen      [::]:443 ssl default_server;
    http2       on;
    server_name ${UI_DOMAIN} ${LOCAL_DOMAIN} localhost;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # Uncomment once you are happy with the cert and always want HTTPS.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    # Elysia/htmx streams HTML; also covers SSE and websocket upgrades.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering    off;
    proxy_cache        off;

    location / {
        proxy_pass http://ui_upstream;
    }
}

# --- Apex mDNS name -> canonical UI hostname ---
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${MDNS_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    return 301 https://${UI_DOMAIN}$request_uri;
}

# --- RabbitMQ management UI ---
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${RABBITMQ_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # The management UI uses websockets (/api/ws) for live updates.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
        proxy_pass http://rabbitmq_upstream;
    }
}
