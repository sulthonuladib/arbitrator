{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@arbitrator/cmc-collector",
    "version": "0.1.0",
    "scripts": {
        "scrape": "bun run src/index.ts --scrape",
        "import": "bun run src/index.ts --import",
        "sync": "bun run src/index.ts --all",
        "indodax": "bun run src/index.ts --indodax",
        "indodax:symbols": "bun run src/index.ts --indodax-symbols",
        "pintu": "bun run src/index.ts --pintu",
        "test": "bun test",
        "typecheck": "bun --check"
    },
    "dependencies": {
        "@arbitrator/sdk": "workspace:*"
    }
}
