{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@arbitrator/ui",
    "version": "1.0.50",
    "type": "module",
    "scripts": {
        "dev": "bun run --watch src/main.ts",
        "dev:tailwind": "tailwindcss -i ./assets/styles/styles.css -o ./public/css/styles.css --watch",
        "build": "bun run build.ts",
        "build:tailwind": "tailwindcss -i ./assets/styles/styles.css -o ./public/css/styles.css",
        "test:browser": "bun tests/browser/keyboard.ts",
        "typecheck": "bun --check"
    },
    "dependencies": {
        "@arbitrator/elysia-kit": "workspace:*",
        "@arbitrator/env-loader": "workspace:*",
        "@arbitrator/lister": "workspace:*",
        "@arbitrator/sdk": "workspace:*",
        "@arbitrator/sender": "workspace:*",
        "@elysia/eden": "catalog:elysia",
        "@elysia/openapi": "catalog:elysia",
        "@elysia/server-timing": "catalog:elysia",
        "@elysia/static": "catalog:elysia",
        "@faker-js/faker": "catalog:tools",
        "@kitajs/html": "^4.2.13",
        "@kitajs/ts-html-plugin": "^4.1.4",
        "clipboard": "^2.0.11",
        "elysia": "catalog:elysia",
        "exact-mirror": "catalog:elysia",
        "htmx.org": "4.0.0",
        "lucide": "^1.50.0",
        "openapi-types": "catalog:elysia",
        "theme-change": "^3.0.4",
        "typebox": "catalog:elysia"
    },
    "devDependencies": {
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "daisyui": "^5.7.47",
        "playwright": "catalog:tools",
        "tailwindcss": "^4.3.3"
    }
}
