{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@arbitrator/lister",
    "version": "0.0.0",
    "private": true,
    "exports": {
        ".": "./src/app.ts",
        "./types": "./src/core/types.ts",
        "./schemas": "./src/core/schemas.ts",
        "./constants": "./src/core/constants.ts"
    },
    "scripts": {
        "dev": "bun run --watch src/index.ts",
        "start": "bun run src/index.ts",
        "build": "bun run build.ts",
        "typecheck": "bun --check",
        "db:migrate": "bunx --bun drizzle-kit migrate",
        "db:generate": "bunx --bun drizzle-kit generate",
        "db:studio": "bunx --bun drizzle-kit studio"
    },
    "dependencies": {
        "@arbitrator/contracts": "workspace:*",
        "@arbitrator/elysia-kit": "workspace:*",
        "@arbitrator/env-loader": "workspace:*",
        "@arbitrator/logger": "workspace:*",
        "@arbitrator/messaging": "workspace:*",
        "@elysia/cors": "catalog:elysia",
        "@elysia/openapi": "catalog:elysia",
        "@sinclair/typebox": "catalog:elysia",
        "drizzle-kit": "catalog:tools",
        "drizzle-orm": "catalog:core",
        "drizzle-seed": "catalog:tools",
        "drizzle-typebox": "catalog:elysia",
        "effect": "^4.0.0",
        "elysia": "catalog:elysia",
        "exact-mirror": "catalog:elysia",
        "openapi-types": "catalog:elysia",
        "pg": "catalog:core",
        "typebox": "catalog:elysia"
    }
}
