{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@arbitrator/lister",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/router.ts",
    "./types": "./src/core/types.ts",
    "./schemas": "./src/core/schemas.ts",
    "./constants": "./src/core/constants.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:studio": "bunx --bun drizzle-kit studio"
  },
  "dependencies": {
    "@arbitrator/contracts": "workspace:*",
    "@arbitrator/logger": "workspace:*",
    "@nats-io/transport-node": "catalog:core",
    "@orpc/server": "catalog:core",
    "drizzle-kit": "catalog:tools",
    "drizzle-orm": "catalog:core",
    "drizzle-seed": "catalog:tools",
    "drizzle-zod": "catalog:core",
    "effect": "^4.0.0",
    "pg": "catalog:core",
    "zod": "catalog:core"
  }
}
